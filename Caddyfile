# HTTPS front door for the dashboard, used only when hosting it publicly.
# The domain comes from the DASHBOARD_DOMAIN environment variable (set in .env).
# Caddy obtains and renews a Let's Encrypt certificate and proxies to the
# dashboard inside the tickstore container. Only this proxy faces the internet;
# ClickHouse, metrics, and the dashboard's direct port stay bound to localhost.
{$DASHBOARD_DOMAIN} {
	reverse_proxy tickstore:8080
}
