# Copy to .env and set real values before deploying. docker-compose reads .env
# automatically. Do NOT commit .env.
CLICKHOUSE_USER=tickstore
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=tickstore

# Only needed to host the dashboard publicly (docker compose --profile public up).
# The domain must have an A record pointing at this server.
DASHBOARD_DOMAIN=dashboard.example.com
